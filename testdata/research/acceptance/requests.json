{
  "schema": "ariadne-research-acceptance-requests-1",
  "cases": [
    {
      "id": "reach-cases",
      "scopes": [
        "all",
        "reachable"
      ],
      "note": "EXPECTED.MD cases a-i; in the reachable bundle g-legacy (a dependency method nothing reaches) resolves as missing, b-unused stays (the input's own methods are in scope)",
      "request": {
        "schema_version": "ariadne-research-query-1",
        "analysis_id": "@ANALYSIS_ID@",
        "request_id": "reach-cases",
        "operation": "reachability",
        "roots": {
          "selection": "indexed"
        },
        "targets": [
          {
            "id": "a-write",
            "selector": {
              "instance_id": "@INSTANCE:app:lib.jar@",
              "class": "fx.research.Extractor",
              "name": "writeEntry",
              "descriptor": "(Ljava/nio/file/Path;[B)V"
            }
          },
          {
            "id": "a-write-by-id",
            "method_id": "@METHOD:fx.research.Extractor#writeEntry@"
          },
          {
            "id": "b-unused",
            "selector": {
              "instance_id": "@INSTANCE:app:lib.jar@",
              "class": "fx.research.Extractor",
              "name": "unused",
              "descriptor": "(Ljava/nio/file/Path;)V"
            }
          },
          {
            "id": "d-save-bytes",
            "selector": {
              "instance_id": "@INSTANCE:app:lib.jar@",
              "class": "fx.research.Extractor",
              "name": "save",
              "descriptor": "([B)V"
            }
          },
          {
            "id": "e-wipe",
            "selector": {
              "instance_id": "@INSTANCE:app:lib.jar@",
              "class": "fx.research.internal.Cleaner",
              "name": "wipe",
              "descriptor": "(Ljava/nio/file/Path;)V"
            }
          },
          {
            "id": "f-resolve",
            "selector": {
              "instance_id": "@INSTANCE:deps:fx-dep-1.0.jar@",
              "class": "fx.dep.Paths2",
              "name": "resolve",
              "descriptor": "(Ljava/nio/file/Path;Ljava/lang/String;)Ljava/nio/file/Path;"
            }
          },
          {
            "id": "g-legacy",
            "selector": {
              "instance_id": "@INSTANCE:deps:fx-dep-1.0.jar@",
              "class": "fx.dep.Paths2",
              "name": "legacyResolve",
              "descriptor": "(Ljava/nio/file/Path;Ljava/lang/String;)Ljava/nio/file/Path;"
            }
