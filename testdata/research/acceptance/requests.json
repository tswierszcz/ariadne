            "id": "h-safe-shadowed",
            "selector": {
              "instance_id": "@INSTANCE:deps:fx-dep-2.0.jar@",
              "class": "fx.dep.Paths2",
              "name": "safeResolve",
              "descriptor": "(Ljava/nio/file/Path;Ljava/lang/String;)Ljava/nio/file/Path;"
            }
          },
          {
            "id": "i-absent",
            "selector": {
              "instance_id": "@INSTANCE:app:lib.jar@",
              "class": "fx.research.Extractor",
              "name": "absent",
              "descriptor": "()V"
            }
          }
        ]
      }
    },
