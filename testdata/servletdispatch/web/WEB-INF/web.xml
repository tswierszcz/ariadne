<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <servlet>
    <servlet-name>hello</servlet-name>
    <servlet-class>sd.HelloServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>hello</servlet-name>
    <url-pattern>/hello</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>plain</servlet-name>
    <servlet-class>sd.PlainServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>plain</servlet-name>
    <url-pattern>/plain</url-pattern>
  </servlet-mapping>
  <filter>
    <filter-name>audit</filter-name>
    <filter-class>sd.AuditFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>audit</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
</web-app>
