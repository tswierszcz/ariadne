# Copy to .env (gitignored) and fill in. Only used when running with -llm.
# ariadne reads these from the environment; it never logs or caches the key.

# OpenAI-compatible base URL. Default if unset: https://openrouter.ai/api/v1
ARIADNE_LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model id for GLM 5.3. Check the exact slug at openrouter.ai/models.
ARIADNE_LLM_MODEL=

# OpenRouter API key. Required when running with -llm.
ARIADNE_LLM_API_KEY=
